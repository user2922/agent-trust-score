# Agent Trust Score — configuration
#
# There are NO REQUIRED variables. The tool runs with an empty environment:
# every value below has a working default, and a missing API key simply means
# reports use template text instead of model-written prose.
#
# Copy to .env.local for local overrides. .env* is gitignored — never commit one.

# ── OPTIONAL — enrichment ────────────────────────────────────────────────────
# Absent ⇒ the tool behaves as if --no-llm was passed and says so on first run.
# This is a console.anthropic.com API key, billed separately from any Claude
# subscription. Roughly $0.25 per audit uncached.
ANTHROPIC_API_KEY=

# ── OPTIONAL — tuning ────────────────────────────────────────────────────────
# Where cached reports live. One JSON file per commit SHA, 24h TTL.
AGENT_TRUST_CACHE_DIR=

# Stop inventorying a repository past this many files. Exceeding it is not an
# error: the report is graded on what was analyzed and marked truncated.
AGENT_TRUST_MAX_FILES=20000

# Stop inventorying past this many bytes. Default 200 MB.
AGENT_TRUST_MAX_BYTES=209715200

# Seconds allowed for `git clone` before giving up.
AGENT_TRUST_CLONE_TIMEOUT=30

# Seconds allowed for the single enrichment call before falling back to templates.
AGENT_TRUST_LLM_TIMEOUT=20

# Model id for the enrichment call. Never hardcoded in source (standing rule 14).
AGENT_TRUST_LLM_MODEL=claude-opus-5
